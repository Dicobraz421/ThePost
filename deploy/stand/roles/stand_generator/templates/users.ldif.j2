# {{ ansible_managed }}
# Учётные записи стенда для импорта в каталог: ldapadd -x -D <админ> -W -f users.ldif (FreeIPA — ipa user-add).
{% for n in range(1, stand_users | int + 1) %}
dn: uid={{ stand_user_prefix }}{{ n }},{{ stand_ldap_base_dn }}
objectClass: inetOrgPerson
uid: {{ stand_user_prefix }}{{ n }}
cn: Stand User {{ n }}
sn: User{{ n }}
mail: {{ stand_user_prefix }}{{ n }}@{{ stand_domain }}
userPassword: {{ stand_user_password }}

{% endfor %}
