# {{ ansible_managed }}
# Учётные записи стенда для импорта в каталог: ldapadd -x -D <админ> -W -f users.ldif (FreeIPA — ipa user-add).
{% for uid in range(1, stand_users | int + 1) | map('string') | map('regex_replace', '^', stand_user_prefix) | list
   + stand_probe_accounts + [stand_big_mailbox] %}
dn: uid={{ uid }},{{ stand_ldap_base_dn }}
objectClass: inetOrgPerson
uid: {{ uid }}
cn: Stand {{ uid }}
sn: {{ uid }}
mail: {{ uid }}@{{ stand_domain }}
userPassword: {{ stand_user_password }}

{% endfor %}
