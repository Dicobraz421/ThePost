# {{ ansible_managed }}
# Параметры стенда для run-scenario.sh (модель нагрузки — APP-D Д.3, сценарии — Д.6, критерии — Д.7).
SMB_HOST={{ stand_smb_hostname }}
SMB_ADDRESS={{ stand_smb_address }}
DOMAIN={{ stand_domain }}
USERS={{ stand_users }}
USER_PREFIX={{ stand_user_prefix }}
ACCOUNTS={{ stand_etc_dir }}/accounts
BIG_MAILBOX={{ stand_big_mailbox }}@{{ stand_domain }}
EXTERNAL_DOMAIN={{ stand_external_domain }}
STAND_DIR={{ stand_dir }}
CA_FILE={{ (stand_etc_dir ~ '/ca.pem') if hostvars[stand_smb_host].thepost_tls_mode | default('acme') == 'internal' else '' }}
IMAPTEST_IMAGE={{ stand_imaptest_image }}
IMAPTEST_ARGS={{ stand_imaptest_args | quote }}
WORKDAY_HOURS={{ stand_model.workday_hours }}
INBOUND_PER_DAY={{ stand_model.inbound_per_day }}
OUTBOUND_PER_DAY={{ stand_model.outbound_per_day }}
OUTBOUND_INTERNAL_SHARE={{ stand_model.outbound_internal_share }}
ONLINE_SHARE={{ stand_model.online_share }}
DEVICES_PER_USER={{ stand_model.devices_per_user }}
SEARCHES_PER_DAY={{ stand_model.searches_per_day }}
FLAG_CHANGES_PER_DAY={{ stand_model.flag_changes_per_day }}
CALENDAR_OPS_PER_DAY={{ stand_model.calendar_ops_per_day }}
INVITATIONS_PER_DAY={{ stand_model.invitations_per_day }}
CONTACT_OPS_PER_DAY={{ stand_model.contact_ops_per_day }}
MANAGESIEVE_PORT={{ stand_managesieve_port }}
PROBE_INTERVAL={{ stand_probe_interval }}
IDLE_CONNECTIONS={{ stand_idle_connections }}
IDLE_HOLD={{ stand_idle_hold }}
LONG_WINDOW={{ stand_long_window }}
STRESS_FACTORS="{{ stand_stress_factors | join(' ') }}"
STRESS_STEP={{ stand_stress_step }}
TAIL_MAX={{ stand_tail_max }}
{% set node_extra = hostvars[stand_smb_host].thepost_config_extra | default({}) %}
{% set node_cfg = node_extra | combine(stand_profiles[stand_profile], recursive=true) %}
{% set abuse = (node_cfg.auth | default({})).abuse | default({}) %}
STAND_PROFILE={{ stand_profile }}
DB_POOL={{ (node_cfg.database | default({})).max_connections | default('') }}
BUS_KIND={{ (node_cfg.bus | default({})).kind | default('') }}
BRUTE_SOURCE={{ stand_bruteforce_source }}
BRUTE_ACCOUNT={{ stand_bruteforce_account }}@{{ stand_domain }}
ABUSE_IP_FAILURES={{ abuse.ip_failures | default(10) }}
ABUSE_ACCOUNT_FAILURES={{ abuse.account_failures | default(20) }}
{% for name, s in stand_scenarios | dictsort %}
SCENARIO_{{ name | upper }}="{{ s.factor }} {{ s.duration }}"
{% endfor %}
