# {{ ansible_managed }}
# Ключ шифрования и ключи S3 pgBackRest для archive_command (архив WAL) и restore_command (PITR): учётные данные
# systemd, расшифровываются при запуске кластера в /run/credentials/{{ thepost_backup_pg_unit }}.
[Service]
LoadCredentialEncrypted=pgbackrest.conf:{{ thepost_backup_creds_dir }}/pgbackrest.cred
