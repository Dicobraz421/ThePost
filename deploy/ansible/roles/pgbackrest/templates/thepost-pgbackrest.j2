#!/bin/sh
# {{ ansible_managed }}
# pgBackRest от имени postgres с секретами из учётных данных systemd (ключ шифрования, ключи S3; источник — OpenBao):
#   thepost-pgbackrest info | check | restore … (аргументы — как у pgbackrest, --stanza уже задан).
set -eu
unit="thepost-pgbackrest-$$"
exec systemd-run --quiet --wait --pipe --collect --service-type=exec --unit="$unit" \
  --uid=postgres --gid=postgres -p WorkingDirectory={{ thepost_backup_pg_home }} \
  -p LoadCredentialEncrypted=pgbackrest.conf:{{ thepost_backup_creds_dir }}/pgbackrest.cred \
  /usr/bin/pgbackrest --config-include-path="/run/credentials/$unit.service" --stanza={{ thepost_backup_stanza }} "$@"
