# {{ ansible_managed }}
# Копия каталога BLOB {{ thepost_backup_blob_dir }} ({{ thepost_backup_blob_tool }}): после каждой копии PostgreSQL
# (thepost-backup@.service) и по таймеру thepost-backup-blob.timer. Объекты неизменяемы и удаляются не раньше окна W
# (SRS 3.5), поэтому копия, сделанная после момента T и не позже T + W, содержит все тела писем на момент T.
[Unit]
Description=The Post: копия каталога писем (BLOB, {{ thepost_backup_blob_tool }})
After=network-online.target
# Каталог потерян или пуст (отказ диска до восстановления) — копию не делать, чтобы не затереть последнюю целую.
ConditionDirectoryNotEmpty={{ thepost_backup_blob_dir }}

[Service]
Type=oneshot
{% if thepost_backup_blob_tool == 'restic' %}
LoadCredentialEncrypted=restic.password:{{ thepost_backup_creds_dir }}/restic-password.cred
{% if thepost_backup_restic_repo is match('s3:') %}
LoadCredentialEncrypted=restic.aws:{{ thepost_backup_creds_dir }}/restic-aws.cred
Environment=AWS_SHARED_CREDENTIALS_FILE=/run/credentials/%n/restic.aws
{% endif %}
Environment=RESTIC_REPOSITORY={{ thepost_backup_restic_repo }}
Environment=RESTIC_PASSWORD_FILE=/run/credentials/%n/restic.password
Environment=RESTIC_CACHE_DIR=/var/cache/restic
# Репозиторий общий со снимком OpenBao (thepost-backup-openbao.service): forget/prune — под общей блокировкой.
ExecStart=/usr/bin/flock -w 3600 /run/lock/thepost-restic.lock /usr/bin/restic {{ thepost_backup_restic_opts }} backup --quiet --tag thepost-blob {{ thepost_backup_blob_dir }}
ExecStart=/usr/bin/flock -w 3600 /run/lock/thepost-restic.lock /usr/bin/restic {{ thepost_backup_restic_opts }} forget --quiet --tag thepost-blob --keep-last 1 --keep-within {{ thepost_backup_restic_keep_within }} --prune
{% else %}
ExecStart=/usr/bin/rsync -a --numeric-ids{{ ' --delete' if thepost_backup_rsync_delete else '' }} -e "ssh -o BatchMode=yes" {{ thepost_backup_blob_dir }}/ {{ thepost_backup_rsync_dest }}/
{% endif %}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
