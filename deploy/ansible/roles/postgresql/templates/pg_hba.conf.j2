# {{ ansible_managed }}
# Сокет — администратор postgres (peer); по сети — только TLS (решение 2026-10-30), открытый канал отклоняется.
# TYPE    DATABASE  USER  ADDRESS  METHOD
local     all       postgres       peer
local     all       all            peer
{% for net in postgresql_app_networks %}
{% for role in [postgresql_app_role, postgresql_owner_role, postgresql_readonly_role] %}
hostssl   {{ postgresql_app_db }}  {{ role }}  {{ net }}  scram-sha-256
{% endfor %}
{% endfor %}
hostnossl all       all   0.0.0.0/0  reject
hostnossl all       all   ::/0       reject
