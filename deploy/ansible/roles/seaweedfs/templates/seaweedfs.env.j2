# {{ ansible_managed }}
# Секреты SeaweedFS (OpenBao, small-enterprise.yml) — переменные WEED_* поверх security.toml и filer.toml; каждому
# компоненту — только свои: master и volume — ключ записи на volume, filer и шлюз S3 — ключ записи в filer.
{% if seaweedfs_components | intersect(['master', 'volume']) | length > 0 %}
WEED_JWT_SIGNING_KEY={{ seaweedfs_jwt_signing_key }}
{% endif %}
{% if seaweedfs_components | intersect(['filer', 's3']) | length > 0 %}
WEED_JWT_FILER_SIGNING_KEY={{ seaweedfs_jwt_filer_signing_key }}
{% endif %}
{% if 'filer' in seaweedfs_components %}
WEED_POSTGRES2_PASSWORD={{ seaweedfs_filer_db_password }}
# Подключение к primary из списка узлов (pgx, переключение pg_auto_failover).
PGTARGETSESSIONATTRS=read-write
{% endif %}
