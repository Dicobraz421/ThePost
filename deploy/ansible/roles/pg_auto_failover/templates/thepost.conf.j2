# {{ ansible_managed }}
# Узел данных pg_auto_failover для The Post (SRS 3.1): пароли — SCRAM, TLS не ниже 1.2. Параметры TLS и репликации —
# у pg_autoctl (postgresql-auto-failover.conf).
password_encryption = 'scram-sha-256'
ssl_min_protocol_version = 'TLSv1.2'
# Время сеансов и журналов — UTC (решение 2026-11-11 №24; thepost doctor: database.timezone, database.log_timezone).
timezone = 'UTC'
log_timezone = 'UTC'
{% for name, value in pgaf_settings | dictsort %}
{{ name }} = {{ value if value is number else "'" ~ value ~ "'" }}
{% endfor %}
