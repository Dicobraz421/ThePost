# The Post: юнит systemd для профилей SMB и Enterprise-ВМ (SRS 1.2; минимальные привилегии — SRS 2.7, 6.8, DEP-08).
# Установка: deploy/README.md. Локальные отличия — drop-in `systemctl edit thepost`
# (например, ReadWritePaths= для BLOB-каталога вне /var/lib/thepost).
#
# Порты ниже 1024 (25, 465, 587, 143, 993, 443) слушает systemd: юниты thepost-*.socket передают процессу готовые
# сокеты (LISTEN_FDS, имена — FileDescriptorName=), у процесса нет ни одной capability (решение 102): другого
# способа открыть эти порты нет — юниты сокетов включаются вместе со службой.
# Проверка: systemd-analyze security thepost.service (не хуже 2.0), thepost doctor (privileges_* — Ok).

[Unit]
Description=The Post mail server
Documentation=https://github.com/Dicobraz421/ThePost
Wants=network-online.target
After=network-online.target postgresql.service
# Без предела числа попыток перезапуска (решение 85): узел ждёт СУБД, OpenBao и сеть сколько нужно.
StartLimitIntervalSec=0

[Service]
Type=exec
User=thepost
Group=thepost
ExecStart=/usr/local/bin/thepost serve --config /etc/thepost/config.yaml
Restart=on-failure
# Пауза перезапуска растёт с 10 с до 5 мин за 6 шагов (systemd 254+; решение 85, APP-31). После длинной серии сбоев
# узел вернётся не позже чем через 5 минут после устранения причины; сразу — `systemctl restart thepost`.
# systemd < 254 (Debian 12, AlmaLinux 9, РЕД ОС 8) ключи RestartSteps и RestartMaxDelaySec не знает и пропускает:
# там пауза постоянная — drop-in thepost.service.d/restart-legacy.conf (30 с; роль Ansible ставит его сама).
RestartSec=10s
RestartSteps=6
RestartMaxDelaySec=5min
TimeoutStopSec=60s
LimitNOFILE=1048576

# Каталоги: /etc/thepost (чтение; владелец root, config.yaml 0640 root:thepost — секретов в нём нет, только ссылки),
# /var/lib/thepost (данные, локальный BLOB), /run/thepost.
ConfigurationDirectory=thepost
StateDirectory=thepost
StateDirectoryMode=0750
RuntimeDirectory=thepost
RuntimeDirectoryMode=0750
UMask=0027

# Вход в OpenBao (AppRole): secret_id — учётные данные systemd, процессу доступен только
# /run/credentials/thepost.service/openbao-secret-id. С TPM — LoadCredentialEncrypted= (systemd-creds encrypt --with-key=tpm2).
LoadCredential=openbao-secret-id:/etc/thepost/credentials/openbao-secret-id

# Привилегии: ни одной capability (сокеты портов ниже 1024 — от systemd), новые привилегии недоступны,
# пространство пользователей — своё (в нём только root и thepost).
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateUsers=yes

# Изоляция файловой системы и ядра.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private

# Сеть: только IP и сокеты Unix; netlink — адреса интерфейсов (getifaddrs).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Системные вызовы: набор служб без привилегированных, отладки, монтирования и смены часов. Профили seccomp
# и Landlock ролей процесс накладывает сам поверх этого (секция confine, SYS-07). Пул подпроцессов с cgroup
# (search.extract.sandbox.cgroup_dir) — drop-in с Delegate=yes.
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Свои профили процесс накладывает сам: seccomp и Landlock (в @system-service их нет).
SystemCallFilter=seccomp landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @debug @mount @clock @cpu-emulation @obsolete @raw-io @reboot @swap @module
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
