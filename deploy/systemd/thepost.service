# The Post: юнит systemd для профилей SMB и Enterprise-ВМ (SRS 1.2).
# Установка: deploy/README.md. Локальные отличия — drop-in `systemctl edit thepost`
# (например, ReadWritePaths= для BLOB-каталога вне /var/lib/thepost).

[Unit]
Description=The Post mail server
Documentation=https://github.com/Dicobraz421/ThePost
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=thepost
Group=thepost
ExecStart=/usr/local/bin/thepost serve --config /etc/thepost/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
LimitNOFILE=1048576

# Каталоги: /etc/thepost (чтение; владелец root, config.yaml 0640 root:thepost — секретов в нём нет, только ссылки),
# /var/lib/thepost (данные, локальный BLOB), /run/thepost.
ConfigurationDirectory=thepost
StateDirectory=thepost
StateDirectoryMode=0750
RuntimeDirectory=thepost
RuntimeDirectoryMode=0750
UMask=0027

# Вход в OpenBao (AppRole): secret_id — учётные данные systemd, процессу доступен только
# /run/credentials/thepost.service/openbao-secret-id. С TPM — LoadCredentialEncrypted= (systemd-creds encrypt --with-key=tpm2).
LoadCredential=openbao-secret-id:/etc/thepost/credentials/openbao-secret-id

# Порты <1024 (25, 465, 587, 143, 993, 80, 443) без root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Изоляция.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
