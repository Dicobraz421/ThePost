# The Post: сокет порта 143 (IMAP) — его слушает systemd и передаёт thepost.service (LISTEN_FDS, SRS 2.7).
# Адрес слушателя в config.yaml — 0.0.0.0:143, [::]:143 или ровно адрес ListenStream= (drop-in:
# `systemctl edit thepost-imap.socket`, «ListenStream=» и новый адрес). Перезапуск thepost не закрывает сокет:
# соединения ждут в очереди.

[Unit]
Description=The Post IMAP socket (port 143)
Documentation=https://github.com/Dicobraz421/ThePost

[Socket]
ListenStream=143
BindIPv6Only=both
FileDescriptorName=imap
Service=thepost.service
NoDelay=yes

[Install]
WantedBy=sockets.target
