# The Post: сокет порта 4190 (ManageSieve) — его слушает systemd и передаёт thepost.service (LISTEN_FDS, SRS 2.7).
# Адрес слушателя в config.yaml (sieve.managesieve.listen) — 0.0.0.0:4190, [::]:4190 или ровно адрес ListenStream=
# (drop-in: `systemctl edit thepost-managesieve.socket`, «ListenStream=» и новый адрес). Перезапуск thepost не
# закрывает сокет: соединения ждут в очереди.

[Unit]
Description=The Post ManageSieve socket (port 4190)
Documentation=https://github.com/Dicobraz421/ThePost

[Socket]
ListenStream=4190
BindIPv6Only=both
FileDescriptorName=managesieve
Service=thepost.service
NoDelay=yes

[Install]
WantedBy=sockets.target
