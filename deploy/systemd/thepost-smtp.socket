# The Post: сокет порта 25 (SMTP) — его слушает systemd и передаёт thepost.service (LISTEN_FDS, SRS 2.7).
# Адрес слушателя в config.yaml — 0.0.0.0:25, [::]:25 или ровно адрес ListenStream= (drop-in:
# `systemctl edit thepost-smtp.socket`, «ListenStream=» и новый адрес). Перезапуск thepost не закрывает сокет:
# соединения ждут в очереди.

[Unit]
Description=The Post SMTP socket (port 25)
Documentation=https://github.com/Dicobraz421/ThePost

[Socket]
ListenStream=25
BindIPv6Only=both
FileDescriptorName=smtp
Service=thepost.service
NoDelay=yes

[Install]
WantedBy=sockets.target
