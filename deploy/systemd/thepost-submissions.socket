# The Post: сокет порта 465 (submission/TLS) — его слушает systemd и передаёт thepost.service (LISTEN_FDS, SRS 2.7).
# Адрес слушателя в config.yaml — 0.0.0.0:465, [::]:465 или ровно адрес ListenStream= (drop-in:
# `systemctl edit thepost-submissions.socket`, «ListenStream=» и новый адрес). Перезапуск thepost не закрывает сокет:
# соединения ждут в очереди.

[Unit]
Description=The Post submission/TLS socket (port 465)
Documentation=https://github.com/Dicobraz421/ThePost

[Socket]
ListenStream=465
BindIPv6Only=both
FileDescriptorName=submissions
Service=thepost.service
NoDelay=yes

[Install]
WantedBy=sockets.target
